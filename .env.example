POSTGRES_USER=appuser
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=appdb

DATABASE_URL=postgresql+asyncpg://appuser:supersecret@db:5432/appdb
PROPLINE_API_KEY=your_key_here
ADMIN_TOKEN=change_me

# Optional. The forward container always runs the scheduled jobs; the dev backend only does if you set this,
# and the two must never run them against the same database at once.
# DEV_SCHEDULER_ENABLED=0
# DEV_TRAIN_SCHEDULE=off        # off / weekly / nightly
